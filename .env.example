# ==============================================================================
# Top10 Environment Variables Configuration
# ==============================================================================

# Supabase Client Configuration (Frontend)
# If left empty, the app runs gracefully on reactive local storage mock data!
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Edge Functions (Never expose in frontend client code!)
# Used inside supabase/functions/fetch-tools
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Gemini AI API Key (Edge Function only)
# Used for Google Search Grounding and candidate synthesis
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
